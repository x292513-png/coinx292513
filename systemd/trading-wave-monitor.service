[Unit]
Description=Isolated Binance wave monitor collector and Telegram delivery
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=tradewave
Group=tradewave
WorkingDirectory=/opt/trading-wave-monitor
Environment=WAVE_ROOT=/opt/trading-wave-monitor
Environment=PYTHONUNBUFFERED=1
ExecStart=/opt/trading-wave-monitor/.venv/bin/python -m wave_monitor.engine
Restart=on-failure
RestartSec=10
UMask=0007
Nice=10
CPUQuota=40%
MemoryMax=512M
TasksMax=64
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/opt/trading-wave-monitor/data
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6

[Install]
WantedBy=multi-user.target
